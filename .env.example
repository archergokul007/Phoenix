# ─── Oracle Database Connection ───────────────────────────────────────────────
# Copy this file to .env and fill in your Oracle credentials.
# IMPORTANT: Never commit .env to version control.

ORACLE_USER=phoenix_academy
ORACLE_PASSWORD=YourPassword@123
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=XEPDB1

# ─── Thick Mode (Only needed for Oracle Wallet / Advanced Authentication) ─────
# Uncomment and set path to Oracle Instant Client if Thick Mode is required.
# ORACLE_INSTANT_CLIENT=C:/oracle/instantclient_21_13
